{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "1.1",
      "enum": [
        "1.0",
        "1.1"
      ],
      "title": "Schema Version",
      "type": "string"
    },
    "event_id": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Event Id",
      "type": "string"
    },
    "match_id": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Match Id",
      "type": "string"
    },
    "sequence": {
      "minimum": 1,
      "title": "Sequence",
      "type": "integer"
    },
    "period": {
      "default": 1,
      "enum": [
        1,
        2
      ],
      "title": "Period",
      "type": "integer"
    },
    "match_second": {
      "maximum": 9000,
      "minimum": 0,
      "title": "Match Second",
      "type": "integer"
    },
    "team_id": {
      "enum": [
        "home",
        "away"
      ],
      "title": "Team Id",
      "type": "string"
    },
    "player_id": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Player Id",
      "type": "string"
    },
    "type": {
      "enum": [
        "kickoff",
        "pass",
        "shot",
        "goal",
        "recovery"
      ],
      "title": "Type",
      "type": "string"
    },
    "x": {
      "maximum": 100,
      "minimum": 0,
      "title": "X",
      "type": "number"
    },
    "y": {
      "maximum": 100,
      "minimum": 0,
      "title": "Y",
      "type": "number"
    },
    "source": {
      "const": "synthetic",
      "default": "synthetic",
      "title": "Source",
      "type": "string"
    },
    "possession_id": {
      "anyOf": [
        {
          "maxLength": 100,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Possession Id"
    },
    "end_x": {
      "anyOf": [
        {
          "maximum": 100,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "End X"
    },
    "end_y": {
      "anyOf": [
        {
          "maximum": 100,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "End Y"
    },
    "outcome": {
      "anyOf": [
        {
          "enum": [
            "complete",
            "saved",
            "blocked",
            "missed",
            "goal"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Outcome"
    },
    "related_event_id": {
      "anyOf": [
        {
          "maxLength": 100,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Related Event Id"
    }
  },
  "required": [
    "event_id",
    "match_id",
    "sequence",
    "match_second",
    "team_id",
    "player_id",
    "type",
    "x",
    "y"
  ],
  "title": "MatchEvent",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
