# Set these in the backend terminal environment. This file is a template only.
# Keep AI off until your Foundry model and credentials are ready.
MATCHOS_AI_MODE=off
AZURE_OPENAI_BASE_URL=https://YOUR-RESOURCE.openai.azure.com/openai/v1
AZURE_OPENAI_DEPLOYMENT=YOUR-DEPLOYMENT-NAME
AZURE_OPENAI_API_KEY=

# Optional expressive narration: requires Azure Speech, separate from Foundry chat.
MATCHOS_SPEECH_MODE=off
AZURE_SPEECH_REGION=canadacentral
AZURE_SPEECH_KEY=

# Single-worker local demo. Values are backend environment variables, not VITE_*.
MATCHOS_ENV=local
# Container Apps HTTP ingress only; leave none for local/other hosting.
MATCHOS_PROXY_MODE=none
MATCHOS_AI_CALL_BUDGET=100
# Optional trusted CLI ingestion only; leave empty for ordinary browser replay.
# If enabled, generate a random value of at least 32 characters and keep it private.
MATCHOS_INGEST_TOKEN=
# Production: set exact public host/origin, use HTTPS, one worker, no reload.
MATCHOS_ALLOWED_HOSTS=localhost,127.0.0.1
MATCHOS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175
